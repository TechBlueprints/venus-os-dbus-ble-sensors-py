#!/bin/sh
#
# dbus-ble-sensors-py-launcher script (curl install)
# Monitor dbus setting to start/stop service dbus-ble-sensors-py accordingly.
#
echo "*** starting dbus-ble-sensors-py-launcher ***"
exec 2>&1
set -e

get_setting() {
  dbus-send --print-reply=literal --system --type=method_call \
  --dest=com.victronenergy.settings "$1" com.victronenergy.BusItem.GetValue |
  awk '/int32/ { print $NF; exit }'
}

# Overridable so the control logic can be exercised in tests
# against a temporary tree; never set in production.
SVC_LINK="${SVC_LINK:-/service/dbus-ble-sensors-py}"

# svc talks to supervise through a control fifo.  If supervise is not
# running, svc prints a warning, changes nothing, and the caller has no
# idea its request evaporated.  That is tolerable when we are shutting
# down (the installer tears the tree down on purpose, in that order),
# and not tolerable when a setting change asked us to start or stop the
# service — which is the whole reason this process exists.
#
# So: control() waits up to $2 seconds for supervise, and reports what
# actually happened.  Callers that care wait; the teardown path passes 0
# and accepts "already gone" as success.
#
# Returns 0 on success, 1 if supervise never appeared, 2 if svc failed.
control() {
  flag="$1"
  wait_s="$2"
  waited=0
  while [ ! -p "$SVC_LINK/supervise/control" ]; do
    if [ "$waited" -ge "$wait_s" ]; then
      return 1
    fi
    waited=$((waited + 1))
    sleep 1
  done
  svc "$flag" "$SVC_LINK" || return 2
  return 0
}

start() {
  [ "$STATE" = "1" ] && return
  echo "Starting dbus-ble-sensors-py service..."
  if control -u 5; then
    STATE="1"
  else
    # Deliberately do NOT record the new state on failure.  Believing we
    # started something we did not is worse than trying again: the next
    # setting change would short-circuit on the cached STATE and the
    # service would stay down with nothing in the log to say why.
    echo "  FAILED to start: supervise for $SVC_LINK is not running."
    echo "  BLE sensors are DOWN and will stay down until this is fixed."
  fi
}

stop() {
  [ "$STATE" = "0" ] && return
  echo "Stopping dbus-ble-sensors-py service..."
  if control -d 5; then
    STATE="0"
  else
    echo "  FAILED to stop: supervise for $SVC_LINK is not running."
    echo "  The service may still be running; check with svstat."
  fi
}

quit() {
  # Disarm first.  quit is the handler for INT, TERM *and* EXIT, and
  # the exit below re-enters it through the EXIT trap — which is why
  # the previous version printed "Stopping" twice on every signal.
  trap - INT TERM EXIT
  # Teardown, not a setting change.  If supervise is already gone the
  # service is going down with it, so there is nothing to stop and no
  # reason to wait or to log a scary line about it — this is the normal
  # shape of an install or a disable.
  if [ "$STATE" != "0" ]; then
    if [ -p "$SVC_LINK/supervise/control" ]; then
      echo "Stopping dbus-ble-sensors-py service..."
      control -d 0 || echo "  stop failed; check svstat $SVC_LINK"
    else
      echo "Launcher exiting; $SVC_LINK supervise is already gone."
    fi
  fi
  [ -n "$FIFO" ] && rm -f "$FIFO"
  exit 0
}
trap 'quit' INT TERM EXIT

# Wait for com.victronenergy.settings to be available
while :; do
  if dbus-send --system --type=method_call --print-reply=literal \
      --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.ListNames 2>/dev/null |
      grep -q "com.victronenergy.settings"; then
    break
  fi
  echo "Waiting for com.victronenergy.settings D-Bus service..."
  sleep 1
done

# Apply initial state
STATE=$(svstat /service/dbus-ble-sensors-py 2>/dev/null | awk '/up/ {print 1; exit} /down/ {print 0; exit} END{print 0}')
setting=$(get_setting /Settings/Services/BleSensors)
if [ "$setting" = "1" ]; then
  start
else
  stop
fi

# Listen for PropertiesChanged on /Settings/Services/BleSensors
FIFO="/tmp/dbus_ble_sensors_pipe.$$"
rm -f "$FIFO"
mkfifo "$FIFO"
dbus-monitor --system \
  "type='signal',sender='com.victronenergy.settings',path='/Settings/Services/BleSensors',interface='com.victronenergy.BusItem',member='PropertiesChanged'" \
  "type='signal',sender='com.victronenergy.settings',path='/Settings/Services/BleSensors',interface='com.victronenergy.BusItem',member='ValueChanged'" > "$FIFO" &
MONITOR_PID=$!

while IFS= read -r line; do
  case "$line" in
    *int32* )
      state=${line##*int32 }
      case "$state" in
        1) start ;;
        0) stop ;;
        *) ;;
      esac
    ;;
  esac
done < "$FIFO"

kill "$MONITOR_PID" 2>/dev/null
quit
