#!/bin/sh
#
# daemontools run script for dbus-ble-sensors-py (curl install)
#
echo "*** starting dbus-ble-sensors-py ***"
exec 2>&1
. /etc/profile.d/profile.sh 2>/dev/null || true

INSTALL_DIR="/data/apps/dbus-ble-sensors-py"
APP_DIR="$INSTALL_DIR/src/opt/victronenergy/dbus-ble-sensors-py"

get_setting() {
  dbus-send --print-reply=literal --system --type=method_call \
  --dest=com.victronenergy.settings "$1" com.victronenergy.BusItem.GetValue |
  awk '/int32/ { print $NF; exit }'
}

if ! ls /sys/class/bluetooth/* >/dev/null 2>&1; then
  echo "Error: No bluetooth device detected, cancelling service launch"
  svc -d .
  exit 1
fi

if [ "$(get_setting /Settings/Services/BleSensors)" != 1 ]; then
  echo "Error: Bluetooth service deactivated by configuration, cancelling service launch"
  svc -d .
  exit 1
fi

# Passive scanning wants bluetoothd with --experimental.  Start it only
# if nothing else has, and start it so that it OUTLIVES US.
#
# Two defects lived here, both found the hard way on prod (2026-08-23).
#
# 1. `bluetoothd -E &` made the daemon a CHILD of this service.  With no
#    stock bluetooth entry in /service, we became the box's de facto
#    owner of bluetoothd — so every restart of this service killed it
#    with our process group and spawned a new one, taking org.bluez off
#    the system bus for EVERY BLE consumer.  That is what produced
#    org.freedesktop.DBus.Error.ServiceUnknown in other services, dropped
#    thermostat monitors, and BMS reconnects, once per deploy.
#
# 2. We ignored the box's own configuration.  /etc/default/bluetooth sets
#    "-E -f /etc/bluetooth/ble.conf", and that file carries
#    ControllerMode = le, ReverseServiceDiscovery = false and
#    Privacy = device.  Starting bare `bluetoothd -E` applied none of it
#    (main.conf holds no active settings), so a controller configured to
#    be LE-only silently ran dual-mode instead — on whichever bluetoothd
#    we had spawned, which was most of them.
#
# So: prefer the init script, which owns both the options and the
# lifetime.  Failing that, honour /etc/default/bluetooth's options and
# detach with setsid so a restart of ours is not a restart of the box's
# Bluetooth.  The right long-term answer is a proper runit service entry
# for bluetoothd; this only stops us making its lifetime our accident.
if ! pidof bluetoothd > /dev/null 2>&1; then
  if [ -x /etc/init.d/bluetooth ]; then
    echo "Starting bluetoothd via /etc/init.d/bluetooth (its own config and lifetime)..."
    /etc/init.d/bluetooth start || true
    sleep 2
  elif [ -x /usr/libexec/bluetooth/bluetoothd ]; then
    BT_OPTS="-E"
    [ -f /etc/bluetooth/ble.conf ] && BT_OPTS="$BT_OPTS -f /etc/bluetooth/ble.conf"
    echo "Starting bluetoothd detached ($BT_OPTS)..."
    if command -v setsid > /dev/null 2>&1; then
      setsid /usr/libexec/bluetooth/bluetoothd $BT_OPTS < /dev/null > /dev/null 2>&1 &
    else
      # No setsid: still better than nothing, but this one dies with us.
      echo "Note: setsid unavailable — bluetoothd will not survive a restart of this service"
      /usr/libexec/bluetooth/bluetoothd $BT_OPTS &
    fi
    sleep 2
  fi
elif ! cat /proc/$(pidof bluetoothd)/cmdline 2>/dev/null | tr '\0' ' ' | grep -qE '\-E|--experimental'; then
  echo "Note: bluetoothd running without --experimental; passive scanning may fall back"
fi

exec python3 "$APP_DIR/dbus_ble_sensors.py"
